export default function HLD() {
  const Box = ({ title, subtitle, color, width = "w-32" }) => (
    <div className={`${width} border-2 ${color} rounded-lg p-2 text-center text-xs font-semibold bg-white shadow`}>
      <div>{title}</div>
      {subtitle && <div className="text-gray-500 font-normal text-xs">{subtitle}</div>}
    </div>
  );

  const Arrow = ({ label }) => (
    <div className="flex flex-col items-center my-1">
      <div className="text-gray-400 text-xs">{label}</div>
      <div className="text-gray-500 text-lg">↓</div>
    </div>
  );

  const HArrow = () => <div className="text-gray-400 mx-1">→</div>;

  return (
    <div className="p-6 bg-gray-50 min-h-screen font-sans">
      <h1 className="text-xl font-bold text-center mb-1">Movie Booking Platform — HLD</h1>
      <p className="text-center text-gray-500 text-sm mb-6">High Level Architecture</p>

      {/* Client Layer */}
      <div className="flex justify-center mb-2">
        <Box title="Client" subtitle="Web / Mobile" color="border-blue-400" width="w-40" />
      </div>

      <Arrow label="HTTPS" />

      {/* API Gateway */}
      <div className="flex justify-center mb-2">
        <Box title="API Gateway" subtitle="Auth · Rate Limit · Routing" color="border-purple-500" width="w-56" />
      </div>

      <Arrow label="JWT validated" />

      {/* Services Layer */}
      <div className="flex justify-center gap-4 mb-2">
        <Box title="Movie Service" subtitle="Browse movies" color="border-green-500" />
        <Box title="Show Service" subtitle="Shows & Seats" color="border-green-500" />
        <Box title="Booking Service" subtitle="Book tickets" color="border-red-500" />
        <Box title="Theatre Service" subtitle="B2B onboarding" color="border-green-500" />
      </div>

      {/* DB + Kafka Layer */}
      <div className="flex justify-center gap-6 mt-4 mb-2 items-start">

        {/* Left - DB */}
        <div className="flex flex-col items-center gap-2">
          <div className="text-xs text-gray-500 font-semibold mb-1">Persistence</div>
          <Box title="PostgreSQL" subtitle="Movies · Shows" color="border-yellow-500" />
          <Box title="PostgreSQL" subtitle="Bookings · Seats" color="border-yellow-500" />
          <Box title="Redis" subtitle="Cache · Shows" color="border-orange-400" />
        </div>

        {/* Middle Arrow */}
        <div className="flex flex-col items-center justify-center mt-10">
          <div className="text-xs text-gray-400">Booking confirmed</div>
          <div className="text-2xl text-gray-400">→</div>
          <div className="text-xs text-gray-400">Kafka event</div>
        </div>

        {/* Right - Kafka + Notifications */}
        <div className="flex flex-col items-center gap-2">
          <div className="text-xs text-gray-500 font-semibold mb-1">Event Streaming</div>
          <Box title="Kafka" subtitle="booking-events topic" color="border-red-400" width="w-40" />
          <div className="text-gray-400">↓</div>
          <Box title="Notification Service" subtitle="Consumer Group" color="border-blue-400" width="w-40" />
          <div className="flex gap-2 mt-1">
            <Box title="📧 Email" color="border-gray-400" width="w-20" />
            <Box title="📱 SMS" color="border-gray-400" width="w-20" />
          </div>
        </div>
      </div>

      {/* Locking callout */}
      <div className="flex justify-center mt-6">
        <div className="bg-yellow-50 border border-yellow-400 rounded-lg p-3 text-xs max-w-lg text-center">
          <span className="font-bold">🔒 Concurrency:</span> Pessimistic Write Lock on seat fetch via{" "}
          <code className="bg-yellow-100 px-1 rounded">@Lock(PESSIMISTIC_WRITE)</code> — prevents double booking at DB level.
          Entire booking wrapped in <code className="bg-yellow-100 px-1 rounded">@Transactional</code>.
        </div>
      </div>

      {/* Strategy pattern callout */}
      <div className="flex justify-center mt-3">
        <div className="bg-green-50 border border-green-400 rounded-lg p-3 text-xs max-w-lg text-center">
          <span className="font-bold">💡 Discount (Strategy Pattern):</span> ThirdTicketDiscountStrategy (50% off 3rd ticket) +
          AfternoonDiscountStrategy (20% off 12pm–5pm). New discounts added without modifying existing code — Open/Closed Principle.
        </div>
      </div>

      {/* Tech Stack */}
      <div className="mt-6">
        <h2 className="text-sm font-bold text-center text-gray-600 mb-2">Tech Stack</h2>
        <div className="flex justify-center gap-3 flex-wrap">
          {[
            { name: "Java 17", color: "bg-blue-100 text-blue-700" },
            { name: "Spring Boot", color: "bg-green-100 text-green-700" },
            { name: "PostgreSQL", color: "bg-yellow-100 text-yellow-700" },
            { name: "Kafka", color: "bg-red-100 text-red-700" },
            { name: "Redis", color: "bg-orange-100 text-orange-700" },
            { name: "JWT", color: "bg-purple-100 text-purple-700" },
            { name: "AWS", color: "bg-gray-100 text-gray-700" },
          ].map(t => (
            <span key={t.name} className={`px-3 py-1 rounded-full text-xs font-semibold ${t.color}`}>
              {t.name}
            </span>
          ))}
        </div>
      </div>
    </div>
  );
}